<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="{{ '/assets/boring-cities/maplibre-gl-csp.min.js' | relative_url }}"></script>
<script src="https://cdn.jsdelivr.net/npm/@maplibre/maplibre-gl-leaflet@0.0.22/leaflet-maplibre-gl.js"></script>
<script src="{{ '/assets/boring-cities/basemap.js' | relative_url }}"></script>
<script src="{{ '/assets/boring-cities/app.js' | relative_url }}"></script>
